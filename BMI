import java.util.Scanner;

public class BMICalculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("=== BMI Calculator ===");
        
        // Take user input for weight (in kilograms)
        System.out.print("Enter your weight in kg: ");
        double weight = scanner.nextDouble();

        // Take user input for height (in meters)
        System.out.print("Enter your height in meters (e.g., 1.75): ");
        double height = scanner.nextDouble();

        // Validate height to prevent division by zero
        if (height <= 0) {
            System.out.println("Height must be greater than zero.");
            return;
        }

        // Calculate BMI: weight / (height * height)
        double bmi = weight / (height * height);

        // Determine health category using conditional statements
        String category;
        if (bmi < 18.5) {
            category = "Underweight";
        } else if (bmi >= 18.5 && bmi < 24.9) {
            category = "Normal weight";
        } else if (bmi >= 25 && bmi < 29.9) {
            category = "Overweight";
        } else {
            category = "Obese";
        }

        // Display results
        System.out.printf("\nYour BMI is: %.2f\n", bmi);
        System.out.println("Health Category: " + category);

        scanner.close();
    }
}
